# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Binary (at repo root)
/sigcomply

# Build directories
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts.
# NOTE: do not use a bare `coverage.*` here — it matches Go SOURCE files
# named coverage.go, which is how internal/report/coverage.go silently
# failed to commit (its tests landed, the implementation did not, and the
# release build broke on `undefined: buildCoverage`). List the artifact
# extensions explicitly instead.
*.out
coverage/
coverage.html
coverage.json
coverage.txt
coverage.xml
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.local
.env.*.local

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/
CLAUDE.local.md

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# LocalStack data (docker-compose volume)
volume/

# Security scan results
*.sarif
gosec.sarif
trivy-results.sarif

# SBOM
sbom.spdx.json
sbom.json

# Log files
*.log

# Secrets (never commit these!)
*.pem
*.key
credentials.json
.sigcomply.yaml

# Build artifacts
__debug_bin

# Internal architectural backlog — competitive analysis and paid-tier
# strategy. This repo is public: never commit it.
issues_to_fix.md
